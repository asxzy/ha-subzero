# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Home Assistant instance used by the scripts.
HA_HOST=homeassistant.local
# Long-lived access token: Profile -> Security -> Long-lived access tokens.
HA_TOKEN=

# SSH access to a host that can write to /config, used by scripts/deploy.py.
HA_SSH_HOST=homeassistant.local
HA_SSH_USER=hassio
HA_SSH_PASSWORD=

# Sub-Zero Group account, used by scripts/setup_ha.py to seed a config entry.
USERNAME=
PASSWORD=
